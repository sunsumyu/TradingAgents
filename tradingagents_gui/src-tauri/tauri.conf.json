{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TradingAgents",
  "version": "0.1.0",
  "identifier": "com.tradingagents.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TradingAgents — 股票分析工具",
        "width": 1100,
        "height": 760,
        "minWidth": 820,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
